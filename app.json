{
  "expo": {
    "name": "Konys Pizza",
    "slug": "konys-pizza",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/splash-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.konyspizza.reservas",
      "adaptiveIcon": {
        "backgroundColor": "#0b323e",
        "foregroundImage": "./assets/splash-icon.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0b323e"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "14991522-d3aa-4251-b786-0ca189ec4e3f"
      }
    },
    "owner": "joansanchezz"
  }
}
